# Copy this file to .env.local and fill in real values. Never commit
# .env.local — it's gitignored already (see .gitignore).

# --- Supabase (required) -----------------------------------------------
# Project Settings -> API. The URL and anon/publishable key are safe to
# ship to the browser (NEXT_PUBLIC_ prefix); RLS is what actually protects
# the data, not secrecy of these two values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_, never send to the browser,
# never log it. Used by trusted server code (Edge Functions, admin scripts,
# the Google/WhatsApp sync jobs) to bypass RLS deliberately and safely.
SUPABASE_SERVICE_ROLE_KEY=

# CLI-only, used by `supabase db push --db-url postgresql://postgres:$SUPABASE_DB_PASSWORD@...`
# Not read by the Next.js app.
SUPABASE_DB_PASSWORD=

# --- Integration mode (required) ----------------------------------------
# mock: every repository reads/writes the existing deterministic mock data
#       (src/lib/mock/*) — no Supabase calls happen at all. Default for
#       local development until the live schema + seed are verified.
# live: repositories call Supabase for real. The UI shows a "LIVE DATA"
#       badge instead of "DEMO DATA" (see src/components/shell/DataModeBadge.tsx).
NEXT_PUBLIC_INTEGRATION_MODE=mock

# --- Google Business Profile OAuth (not yet connected — architecture only) --
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the OAuth client in
# Google Cloud Console, e.g. https://yourdomain.com/api/integrations/google/callback
GOOGLE_OAUTH_REDIRECT_URI=

# Server-only. AES-256-GCM key for encrypting OAuth tokens at rest, 32
# raw bytes, base64-encoded. Generate with: openssl rand -base64 32
# Never commit this. Losing it means every stored token becomes
# undecryptable — back it up somewhere safe outside git.
TOKEN_ENCRYPTION_KEY=

# --- WhatsApp (Meta Business Platform) — not yet connected -----------------
WHATSAPP_PROVIDER=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- AI provider — not yet connected ---------------------------------------
AI_PROVIDER=mock
AI_API_KEY=

# --- Meta Ads — not yet connected -------------------------------------------
META_ADS_ACCESS_TOKEN=

# --- Google Ads — not yet connected -----------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
